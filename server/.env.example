PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=moodflix

# For a custom dataset:
MOVIES_COLLECTION=movies
MOVIE_EMBEDDING_FIELD=embedding
VECTOR_INDEX_NAME=movie_vector_index

# For MongoDB sample_mflix.embedded_movies, use:
# MONGODB_DB_NAME=sample_mflix
# MOVIES_COLLECTION=embedded_movies
# MOVIE_EMBEDDING_FIELD=plot_embedding
# VECTOR_INDEX_NAME=vector_index

USERS_COLLECTION=users
INTERACTIONS_COLLECTION=interactions
RECOMMENDATION_LOGS_COLLECTION=recommendation_logs

DEFAULT_RECOMMENDATION_LIMIT=10
VECTOR_NUM_CANDIDATES=150
